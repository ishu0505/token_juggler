# Credentials for the accounts in token_daddy.yaml. Each account names the env
# var it reads, so these names are only the defaults used by the example config.
# An account whose variables are unset is skipped (see `token-daddy check`).

# Which config to load (default: ./token_daddy.yaml)
TOKEN_DADDY_CONFIG=token_daddy.yaml

# Shared quota state. Every service/project pointing at the same Redis shares
# the same quotas. Unset -> per-process limits only.
REDIS_URL=redis://localhost:6379/0

# OpenAI Platform
OPENAI_API_KEY=

# Databricks AI Gateway (GPT, Gemini and Claude)
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=

# AWS Bedrock - a Bedrock API key (used as the OpenAI SDK key for GPT models)
BEDROCK_API_KEY=

# Google AI Studio
GOOGLE_AI_STUDIO_API_KEY=

# Vertex AI - auth is Application Default Credentials
# (`gcloud auth application-default login`, or a service account below)
VERTEX_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Anthropic (Claude Platform)
ANTHROPIC_API_KEY=
