# Copy this file to .env and fill in the credentials for whichever providers you use.
# Nothing here is required at import time - each provider integration should treat its
# own block as optional and simply not register that provider/model if unset.

# --- Redis ---
# Shared token/RPM/TPM usage tracking across every app drawing from the same pool.
# When running via docker-compose, this is overridden to redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# --- OpenAI Platform (platform.openai.com) ---
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# --- Anthropic Platform (console.anthropic.com) ---
ANTHROPIC_API_KEY=

# --- Google AI Studio (Gemini API, aistudio.google.com) ---
GOOGLE_AI_STUDIO_API_KEY=

# --- Google Vertex AI ---
# Auth is via GCP Application Default Credentials, not an API key.
VERTEX_PROJECT_ID=
VERTEX_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- AWS Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# e.g. anthropic.claude-opus-5, amazon.titan-*, etc.
BEDROCK_ANTHROPIC_MODEL_ID=

# --- Databricks (model serving endpoints) ---
# Used here for Databricks-hosted Gemini/Llama/etc. endpoints - a second source for
# models that also exist under other providers above (e.g. Gemini via Vertex AI too).
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
